# Server mặc định chỉ nghe trên loopback khi chạy local.
HOST=127.0.0.1
PORT=8000

# Chỉ cần cấu hình khi bootstrap production; không commit mật khẩu thật.
# Cấu hình riêng thông tin đăng nhập quản trị; không dùng lại mật khẩu dịch vụ khác.
ADMIN_NAME=BookNest Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chỉ cấu hình trong secret manager của môi trường deploy.
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Webhook HTTPS tùy chọn để nhận cảnh báo runtime; không đưa URL thật vào repository.
MONITORING_ALERT_WEBHOOK_URL=

# Cấu hình SePay trong secret manager; không điền credential thật ở đây.
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# Firebase Web API key dùng để backend xác minh Firebase ID Token.
FIREBASE_API_KEY=

# Cấu hình khôi phục mật khẩu; dùng URL storefront đã triển khai.
PUBLIC_APP_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Recommended on hosted platforms: HTTPS email API (for example Resend).
RESEND_API_KEY=
RESEND_FROM=

# Frontend build (GitHub Actions repository variable, not a secret)
API_BASE_URL=
# Bảo mật: bật chế độ production (thiết lập NODE_ENV=production trên Render/VPS)
NODE_ENV=development

# Bảo mật: thời gian sống access session (ms), mặc định 8 giờ
SESSION_TTL_MS=28800000

# Bảo mật: thời gian sống refresh token (ms), mặc định 30 ngày
SESSION_REFRESH_TTL_MS=2592000000

# Bảo mật: giới hạn độ dài mật khẩu tối thiểu/tối đa
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
