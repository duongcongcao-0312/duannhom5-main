# Server mặc định chỉ nghe trên loopback khi chạy local.
HOST=127.0.0.1
PORT=8000

# Chỉ cần cấu hình khi bootstrap production; không commit mật khẩu thật.
# Cấu hình riêng thông tin đăng nhập quản trị; không dùng lại mật khẩu dịch vụ khác.
ADMIN_NAME=BookNest Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chỉ cấu hình trong secret manager của môi trường deploy.
DATABASE_URL=
# PostgreSQL connection pool limits are per application instance.
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_MAX_LIFETIME_SECONDS=1800
RATE_LIMIT_HMAC_KEY=
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Global per-client API request limit and rolling window.
API_RATE_LIMIT=300
API_RATE_WINDOW_MS=900000
# App-level in-flight request cap and Node.js request receive timeout.
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_MS=30000
# Exact socket peer IPs allowed to supply X-Forwarded-For; required when hops > 0.
RATE_LIMIT_TRUSTED_PROXY_IPS=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Webhook HTTPS tùy chọn để nhận cảnh báo runtime; không đưa URL thật vào repository.
MONITORING_ALERT_WEBHOOK_URL=

# Backup mã hóa AES-256-GCM; đặt khóa base64 32 byte trong secret manager.
# Khi bắt buộc bật true, scheduler/CLI từ chối tạo backup nếu thiếu khóa.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_REQUIRED=false

# Cấu hình SePay & payment webhook trong secret manager; không điền credential thật ở đây.
PAYMENT_WEBHOOK_SECRET=
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# Firebase Web API key dùng để backend xác minh Firebase ID Token.
FIREBASE_API_KEY=

# Cấu hình khôi phục mật khẩu; dùng URL storefront đã triển khai.
PUBLIC_APP_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Recommended on hosted platforms: HTTPS email API (for example Resend).
RESEND_API_KEY=
RESEND_FROM=

# Frontend build (GitHub Actions repository variable, not a secret)
API_BASE_URL=
# Bảo mật: bật chế độ production (thiết lập NODE_ENV=production trên Render/VPS)
APP_ENV=development
NODE_ENV=development

# Bảo mật: thời gian sống access session (ms), mặc định 8 giờ
SESSION_TTL_MS=28800000

# Bảo mật: thời gian sống refresh token (ms), mặc định 30 ngày
SESSION_REFRESH_TTL_MS=2592000000

# Bảo mật: giới hạn độ dài mật khẩu tối thiểu/tối đa
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Tùy chọn: pin database đích trong staging/production để chống nhầm môi trường.
EXPECTED_DATABASE_NAME=
ALLOW_LOCAL_PROD_DB=false
DATABASE_SSL_CA_PATH=

# Tùy chọn: thêm giới hạn/đường dẫn cho API và vận hành backup.
SESSION_IDLE_TIMEOUT_MS=1800000
PRIVACY_EXPORT_TTL_MS=900000
SESSION_COOKIE_SAMESITE=Lax
BACKUP_DIR=backups
DATA_DIR=data
BACKUP_STATUS_FILE=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LOG_FILE=
BACKUP_ALERT_TIMEOUT_MS=10000
BACKUP_ALERT_WEBHOOK_URL=
# Optional S3-compatible off-site destination (requires AWS CLI credentials and encryption).
BACKUP_S3_URL=
AWS_CLI_PATH=aws
DATABASE_BACKUP_TIMEOUT_MS=1800000
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# Firebase project ID chỉ cần cho token social; API key không phải service-account credential.
FIREBASE_PROJECT_ID=

# Biến cho công cụ smoke/load/performance và quản lý issue; chỉ dùng đúng lệnh tương ứng.
SMOKE_BASE_URL=http://127.0.0.1:8000
SMOKE_TIMEOUT_MS=5000
SMOKE_ALERT_WEBHOOK_URL=
LOAD_TEST_BASE_URL=http://127.0.0.1:8000
LOAD_TEST_REQUESTS=
LOAD_TEST_CONCURRENCY=
LOAD_TEST_TIMEOUT_MS=
LOAD_TEST_SLO_P95_MS=
LOAD_TEST_SLO_ERROR_RATE=
LOAD_TEST_SLO_THROUGHPUT_RPS=
LOAD_TEST_PROFILE=standard
LOAD_TEST_STAGING_HOSTS=
LOAD_TEST_ALLOW_STAGING=false
PERF_BASE_URL=http://127.0.0.1:8000
PERF_BROWSER=
PERF_ITERATION=1
PERF_PAGE=
PERF_VIEWPORT=
PERF_REPEAT=1
HOST_PORT=8000
NODE_VERSION=22
REPO=duongcongcao-0312/duannhom5-main
# Không đặt GITHUB_TOKEN/GH_TOKEN trong file này; cấp tạm qua secret manager của CI.
