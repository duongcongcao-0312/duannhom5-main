# Server mặc định chỉ nghe trên loopback khi chạy local.
HOST=127.0.0.1
PORT=8000
# Chỉ cần cấu hình khi bootstrap production; không commit mật khẩu thật.
# Nếu không đặt ADMIN_EMAIL/ADMIN_PASSWORD, backend local sẽ tạo tài khoản quản trị mặc định:
# admin@booknest.vn / admin123
ADMIN_NAME=BookNest Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Chỉ cấu hình trong secret manager của môi trường deploy.
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Cấu hình khôi phục mật khẩu; dùng URL storefront đã triển khai.
PUBLIC_APP_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Recommended on hosted platforms: HTTPS email API (for example Resend).
RESEND_API_KEY=
RESEND_FROM=

# Frontend build (GitHub Actions repository variable, not a secret)
API_BASE_URL=
